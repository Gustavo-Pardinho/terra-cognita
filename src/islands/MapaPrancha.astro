---
/* =============================================================================
   MAPA-PRANCHA — a lente Mapa, em escala de prancha
   Fase 1: relevo em pirâmide de ladrilhos estáticos, pilha de camadas,
   inspetor de clique, permalink de estado e indicatriz de Tissot.

   Nenhum servidor de ladrilho e nenhum servidor de glifo em tempo de execução:
   os ladrilhos são PNG assados em build, e os rótulos são marcadores HTML,
   para usar a hierarquia tipográfica real do atlas. Ver PR. 02 e PR. 04.
   ========================================================================== */
interface Props { altura?: string }
const { altura = 'clamp(380px, 62vh, 680px)' } = Astro.props;
---
<figure class="mapa" style={`--altura-mapa:${altura}`}>
  <div class="mapa__campo" id="campo" role="application"
       aria-label="Mapa físico-político do Brasil: relevo hipsométrico sombreado, limites estaduais, hidrografia principal e cidades. Use as setas para deslocar e +/− para aproximar. Clique num estado para abrir o inspetor."></div>

  <div class="mapa__controles">
    <fieldset>
      <legend>Camadas</legend>
      <label><input type="checkbox" data-camada="relevo" checked /> Relevo</label>
      <label><input type="checkbox" data-camada="ufs" checked /> Estados</label>
      <label><input type="checkbox" data-camada="hidrografia" checked /> Hidrografia</label>
      <label><input type="checkbox" data-camada="graticulado" checked /> Graticulado</label>
      <label><input type="checkbox" data-camada="rotulos" checked /> Rótulos</label>
    </fieldset>
    <fieldset>
      <legend>Projeção</legend>
      <label><input type="radio" name="proj" value="mercator" checked /> Mercator</label>
      <label><input type="radio" name="proj" value="globe" /> Ortográfica</label>
      <label class="destaque"><input type="checkbox" data-camada="tissot" /> Indicatriz</label>
    </fieldset>
  </div>

  <aside class="inspetor" id="inspetor" hidden aria-live="polite">
    <button class="inspetor__fechar" type="button" id="fechar-inspetor" aria-label="Fechar inspetor">×</button>
    <div id="inspetor-corpo"></div>
  </aside>

  <div class="mapa__legenda legenda">
    <h4>Altitude</h4>
    <div class="rampa rampa--mapa" aria-hidden="true">
      <i style="background:var(--h-planicie)"></i><i style="background:var(--h-baixada)"></i>
      <i style="background:var(--h-colina)"></i><i style="background:var(--h-planalto)"></i>
      <i style="background:var(--h-estepe)"></i><i style="background:var(--h-arido)"></i>
      <i style="background:var(--h-serra)"></i><i style="background:var(--h-montanha)"></i>
      <i style="background:var(--h-rocha)"></i><i style="background:var(--h-neve)"></i>
    </div>
    <div class="rampa__eixo"><span>0</span><span>1200</span><span>+4000 m</span></div>
    <ul>
      <li><i class="linha" style="background:var(--agua)"></i> Hidrografia principal</li>
      <li><i class="ponto"></i> Capital federal</li>
      <li><i class="veu"></i> Fora do território</li>
    </ul>
  </div>

  <div class="tempo-barra">
    <label for="ano">Ano</label>
    <input id="ano" type="range" min="1450" max="2026" step="1" value="2026" />
    <output id="ano-valor" class="mono">2026</output>
    <div class="tempo-barra__estado" id="tempo-estado"></div>
  </div>

  <figcaption class="mapa__pe">
    <span class="escala"><span class="escala__barras"><i></i><i></i><i></i><i></i></span><span id="escala-txt">—</span></span>
    <span class="mapa__coord mono" id="coord">—</span>
  </figcaption>
</figure>

<style>
  .mapa { position: relative; border: 1px solid var(--neat); background: var(--h-pelagico); margin: 0; }
  .mapa__campo { width: 100%; height: var(--altura-mapa); }
  .mapa__campo:focus-visible { outline: 2px solid var(--survey); outline-offset: -2px; }

  .mapa__controles {
    position: absolute; top: var(--s-3); left: var(--s-3); z-index: var(--z-painel);
    display: flex; flex-direction: column; gap: var(--s-2);
  }
  .mapa__controles fieldset {
    border: 1px solid var(--rule); background: var(--overlay);
    padding: var(--s-2) var(--s-3); margin: 0;
    font-family: var(--sans); font-size: var(--t-xs);
    display: flex; flex-direction: column; gap: .2rem;
  }
  .mapa__controles legend {
    font-family: var(--sans); font-size: .6rem; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3);
    padding: 0 .3rem; background: var(--sheet);
  }
  .mapa__controles label { display: flex; align-items: center; gap: .4rem; cursor: pointer; color: var(--ink-2); }
  .mapa__controles label.destaque { color: var(--survey); margin-top: .25rem;
    border-top: 1px solid var(--rule-fine); padding-top: .3rem; }
  .mapa__controles input { accent-color: var(--brass); margin: 0; }
  .mapa__controles label.destaque input { accent-color: var(--survey); }

  .mapa__legenda {
    position: absolute; right: var(--s-3); bottom: calc(var(--s-6) + var(--s-3)); z-index: var(--z-legenda);
    background: var(--overlay); max-width: 15rem;
  }
  .rampa--mapa i { height: 12px; }
  .mapa__legenda .rampa__eixo { gap: .5rem; font-size: .58rem; }
  .mapa__legenda ul { list-style: none; padding: 0; margin: var(--s-2) 0 0; font-family: var(--sans); font-size: var(--t-xs); }
  .mapa__legenda li { display: flex; align-items: center; gap: .5rem; padding: .18rem 0; color: var(--ink-2); }
  .mapa__legenda li i { width: 16px; height: 10px; flex: none; }
  .mapa__legenda i.linha { height: 2px; }
  .mapa__legenda i.veu { background: var(--ground); opacity: .5; border: 1px solid var(--rule); }
  .mapa__legenda i.ponto { width: 9px; height: 9px; border-radius: 50%; border: 2px solid var(--survey); background: var(--sheet); }

  /* --- inspetor: o que o acervo sabe sobre o que foi clicado ------------- */
  .inspetor {
    position: absolute; top: var(--s-3); right: var(--s-3); z-index: var(--z-painel);
    width: min(19rem, calc(100% - 2 * var(--s-3)));
    background: var(--overlay); border: 1px solid var(--neat);
    padding: var(--s-4) var(--s-4) var(--s-3);
    font-family: var(--sans); font-size: var(--t-sm);
  }
  .inspetor[hidden] { display: none; }
  .inspetor__fechar {
    position: absolute; top: .1rem; right: .35rem;
    background: none; border: 0; cursor: pointer;
    font-size: 1.1rem; line-height: 1; color: var(--ink-3); padding: .2rem;
  }
  .inspetor__fechar:hover { color: var(--ink); }
  .inspetor :global(h5) {
    font-family: var(--serif); font-size: 1.15rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: .06em; margin: 0 1.2rem .1rem 0;
  }
  .inspetor :global(.sigla) {
    font-family: var(--mono); font-size: var(--t-xs); color: var(--brass);
    letter-spacing: .1em; display: block; margin-bottom: var(--s-3);
  }
  .inspetor :global(dl) { display: grid; gap: 0; margin: 0; }
  .inspetor :global(dl > div) {
    display: grid; grid-template-columns: 1fr auto; gap: var(--s-3);
    padding: .3rem 0; border-bottom: 1px solid var(--rule-fine);
  }
  .inspetor :global(dt) { color: var(--ink-3); font-size: var(--t-xs); }
  .inspetor :global(dd) { margin: 0; text-align: right; font-size: var(--t-xs); }
  .inspetor :global(dd.mono) { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .inspetor :global(.lacuna) {
    margin-top: var(--s-3); padding-left: var(--s-3);
    border-left: 2px solid var(--brass);
    font-size: var(--t-xs); line-height: 1.5; color: var(--ink-2);
  }

  .tempo-barra {
    display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap;
    border-top: 1px solid var(--neat); background: var(--ground);
    padding: var(--s-2) var(--s-3);
  }
  .tempo-barra label {
    font-family: var(--sans); font-size: var(--t-xs); font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3);
  }
  .tempo-barra input[type="range"] { flex: 1; min-width: 160px; accent-color: var(--brass); }
  .tempo-barra output { font-size: var(--t-sm); color: var(--ink); min-width: 4.5ch; text-align: right; }
  .tempo-barra__estado { display: flex; gap: .3rem; flex-wrap: wrap; }
  .tempo-barra__estado span {
    font-family: var(--mono); font-size: .58rem; letter-spacing: .06em; text-transform: uppercase;
    border: 1px solid currentColor; padding: .1rem .3rem; color: var(--ink-3);
  }
  .tempo-barra__estado span.vigente { color: var(--cert-exata); }
  .tempo-barra__estado span.revogada { color: var(--cert-estimada); }

  .mapa__pe {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    border-top: 1px solid var(--neat); background: var(--sheet);
    padding: .45rem var(--s-3); font-family: var(--mono); font-size: .62rem; color: var(--ink-3);
  }

  /* --- rótulos: a hierarquia tipográfica do atlas, como marcadores HTML --- */
  :global(.rot) {
    display: block; white-space: nowrap; pointer-events: none;
    text-shadow: 0 0 2px var(--halo), 0 0 4px var(--halo), 0 0 6px var(--halo);
    transition: opacity var(--mov-camada) var(--ease-globo);
  }
  :global(.rot--oculto) { opacity: 0; }
  :global(.rot--cidade) { font-family: var(--sans); color: var(--ink); letter-spacing: .01em; }
  :global(.rot--capital) { font-family: var(--sans); font-weight: 600; color: var(--ink); }
  :global(.rot--capital)::before {
    content: ""; display: inline-block; width: 7px; height: 7px; margin-right: .35rem;
    border: 2px solid var(--survey); border-radius: 50%; background: var(--sheet);
    vertical-align: middle;
  }
  :global(.rot--agua) {
    font-family: var(--serif); font-style: italic; letter-spacing: .17em;
    color: var(--agua); font-size: .8rem;
  }
  :global(.rot--regiao) {
    font-family: var(--sans); font-weight: 600; letter-spacing: .3em; text-transform: uppercase;
    color: var(--ink-2); font-size: .68rem;
  }
  :global(.maplibregl-ctrl-attrib) { font-family: var(--sans); font-size: 10px; }
</style>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { lerEstado, escreverEstado, agrupar, indicatriz } from '../lib/estado-mapa';
import { ANO_MAXIMO, TORDESILHAS, tordesilhas, vigenteEm, estadoDeVigencia } from '../lib/tempo';
import { capitais } from '../data/paises/brasil';

  const campo = document.getElementById('campo');
  if (campo) iniciar(campo);

  async function iniciar(campo: HTMLElement) {
    const css = () => getComputedStyle(document.documentElement);
    const tok = (n: string) => css().getPropertyValue(n).trim();

    const PADRAO = new Set(['relevo', 'ufs', 'hidrografia', 'graticulado', 'rotulos']);
    const inicial = lerEstado();
    const ligadas = inicial.camadas ?? new Set(PADRAO);
    let projecao: 'mercator' | 'globe' = inicial.proj ?? 'mercator';
    let ano = inicial.ano ?? ANO_MAXIMO;

    // descritor da pirâmide de relevo; ausente = projeto sem `npm run relevo`
    const rel = await fetch('/dados/relevo.json').then((r) => r.json()).catch(() => null);

    const fontes: Record<string, maplibregl.SourceSpecification> = {
      vizinhos:    { type: 'geojson', data: '/dados/vizinhos.geojson' },
      brasil:      { type: 'geojson', data: '/dados/brasil.geojson' },
      ufs:         { type: 'geojson', data: '/dados/ufs.geojson' },
      hidrografia: { type: 'geojson', data: '/dados/hidrografia.geojson' },
      graticulado: { type: 'geojson', data: '/dados/graticulado.geojson' },
      tissot:      { type: 'geojson', data: indicatriz(500) as never },
      tordesilhas: { type: 'geojson', data: tordesilhas() as never },
      capital:     { type: 'geojson', data: { type: 'FeatureCollection', features: [] } as never },
    };
    if (rel) {
      fontes.relevo = {
        type: 'raster',
        // concatenação crua de propósito: new URL() percent-codifica as chaves
        // {z}/{x}/{y} e o MapLibre passa a pedir um arquivo com esse nome literal
        tiles: [location.origin + rel.esquema],
        tileSize: rel.tamanhoLadrilho,
        minzoom: rel.minzoom,
        maxzoom: rel.maxzoom,          // além disso o MapLibre reamplia o último nível
        bounds: rel.limites,
        attribution: rel.atribuicao,
      };
    }

    const vis = (c: string) => (ligadas.has(c) ? 'visible' : 'none') as 'visible' | 'none';

    const camadas: maplibregl.LayerSpecification[] = [
      { id: 'oceano', type: 'background', paint: { 'background-color': tok('--h-pelagico') } },
      /* Base política sob o relevo. Enquanto o relevo está ligado ela fica
         escondida; serve para dois casos em que o relevo não cobre a tela:
         quando o leitor desliga a camada, e quando sai da extensão assada.
         Sem ela a terra fica da cor do oceano e a prancha se desfaz. */
      { id: 'terra-vizinhos', type: 'fill', source: 'vizinhos',
        paint: { 'fill-color': tok('--sunk') } },
      { id: 'terra-brasil', type: 'fill', source: 'brasil',
        paint: { 'fill-color': tok('--tinta-1') } },
    ];
    if (rel) camadas.push({
      id: 'relevo', type: 'raster', source: 'relevo',
      layout: { visibility: vis('relevo') },
      paint: { 'raster-opacity': 1, 'raster-fade-duration': 0 },
    });
    camadas.push(
      // véu sobre os vizinhos: convenção de atlas para destacar o país em foco
      // o véu acompanha o relevo: sem relevo, a base política já distingue os vizinhos
      { id: 'veu-vizinhos', type: 'fill', source: 'vizinhos',
        layout: { visibility: vis('relevo') },
        paint: { 'fill-color': tok('--ground'), 'fill-opacity': 0.5 } },
      // alvos invisíveis de clique: linha é difícil de acertar com o ponteiro
      { id: 'ufs-alvo', type: 'fill', source: 'ufs', paint: { 'fill-opacity': 0 } },
      { id: 'vizinhos-alvo', type: 'fill', source: 'vizinhos', paint: { 'fill-opacity': 0 } },
      { id: 'graticulado', type: 'line', source: 'graticulado',
        layout: { visibility: vis('graticulado') },
        paint: { 'line-color': tok('--ink'), 'line-width': 0.5, 'line-opacity': 0.18 } },
      { id: 'ufs-linha', type: 'line', source: 'ufs',
        layout: { visibility: vis('ufs') },
        paint: {
          'line-color': tok('--neat'), 'line-opacity': 0.5,
          'line-width': ['interpolate', ['linear'], ['zoom'], 3, 0.4, 7, 1.1],
          'line-dasharray': [3, 2],
        } },
      { id: 'hidrografia-linha', type: 'line', source: 'hidrografia',
        layout: { visibility: vis('hidrografia'), 'line-cap': 'round', 'line-join': 'round' },
        paint: {
          'line-color': tok('--agua'), 'line-opacity': 0.9,
          'line-width': ['interpolate', ['linear'], ['zoom'], 2, 0.5, 6, 2.4],
        } },
      { id: 'brasil-linha', type: 'line', source: 'brasil',
        paint: { 'line-color': tok('--neat'), 'line-width': ['interpolate', ['linear'], ['zoom'], 3, 1.2, 7, 2.4] } },
      /* Tordesilhas: a faixa é a incerteza do meridiano, não um enfeite. Ver
         src/lib/tempo.ts — o tratado não fixa uma linha única. */
      { id: 'tordesilhas-faixa', type: 'fill', source: 'tordesilhas',
        filter: ['==', ['get', 'tipo'], 'faixa'],
        layout: { visibility: 'none' },
        paint: { 'fill-color': tok('--cert-estimada'), 'fill-opacity': 0.18 } },
      { id: 'tordesilhas-tracado', type: 'line', source: 'tordesilhas',
        filter: ['==', ['get', 'tipo'], 'tracado'],
        layout: { visibility: 'none' },
        paint: { 'line-color': tok('--cert-estimada'), 'line-width': 1.4, 'line-dasharray': [4, 3] } },
      /* capital em vigor no ano: símbolo clássico de anel, não rótulo, para não
         duplicar com os nomes de cidade vindos do gazeteiro */
      { id: 'capital-halo', type: 'circle', source: 'capital',
        paint: { 'circle-radius': 9, 'circle-color': 'transparent',
                 'circle-stroke-width': 1, 'circle-stroke-color': tok('--survey'), 'circle-stroke-opacity': 0.5 } },
      { id: 'capital-ponto', type: 'circle', source: 'capital',
        paint: { 'circle-radius': 4.5, 'circle-color': tok('--sheet'),
                 'circle-stroke-width': 2.5, 'circle-stroke-color': tok('--survey') } },
      // indicatriz por cima de tudo: ela é instrumento de medida, não conteúdo
      { id: 'tissot-area', type: 'fill', source: 'tissot',
        layout: { visibility: vis('tissot') },
        paint: { 'fill-color': tok('--survey'), 'fill-opacity': 0.16 } },
      { id: 'tissot-linha', type: 'line', source: 'tissot',
        layout: { visibility: vis('tissot') },
        paint: { 'line-color': tok('--survey'), 'line-width': 1 } },
    );

    const mapa = new maplibregl.Map({
      container: campo,
      center: [inicial.lon ?? -52.5, inicial.lat ?? -14.5],
      zoom: inicial.z ?? 3.3,
      minZoom: 2,
      maxZoom: 8,                     // o DEM assado vai até z7; não blefa além disso
      attributionControl: { customAttribution: 'Natural Earth · domínio público' },
      style: { version: 8, sources: fontes, layers: camadas },
    });
    if (projecao === 'globe') mapa.once('load', () => mapa.setProjection({ type: 'globe' }));
    if (import.meta.env.DEV) {
      const g = window as unknown as Record<string, unknown>;
      g.__mapa = mapa;
      // o estilo exato que esta ilha montou, para reaplicar em depuração
      g.__estilo = { version: 8, sources: fontes, layers: camadas };
    }

    mapa.addControl(new maplibregl.NavigationControl({ visualizePitch: false }), 'bottom-left');
    campo.querySelector<HTMLElement>('.maplibregl-canvas')?.setAttribute('tabindex', '0');
    mapa.on('error', (e) => console.error('[mapa]', e.error?.message ?? e));

    /* --- repintura ao trocar de tema: o mapa segue os tokens --------------- */
    function repintar() {
      const def: Array<[string, string, string]> = [
        ['oceano', 'background-color', '--h-pelagico'],
        ['terra-vizinhos', 'fill-color', '--sunk'],
      ['terra-brasil', 'fill-color', '--tinta-1'],
      ['veu-vizinhos', 'fill-color', '--ground'],
        ['graticulado', 'line-color', '--ink'],
        ['ufs-linha', 'line-color', '--neat'],
        ['hidrografia-linha', 'line-color', '--agua'],
        ['brasil-linha', 'line-color', '--neat'],
        ['tissot-area', 'fill-color', '--survey'],
        ['tissot-linha', 'line-color', '--survey'],
        ['tordesilhas-faixa', 'fill-color', '--cert-estimada'],
        ['tordesilhas-tracado', 'line-color', '--cert-estimada'],
        ['capital-ponto', 'circle-color', '--sheet'],
      ];
      for (const [camada, prop, token] of def) {
        if (mapa.getLayer(camada)) mapa.setPaintProperty(camada, prop as never, tok(token));
      }
    }
    new MutationObserver(repintar).observe(document.documentElement, { attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', repintar);

    /* --- permalink de estado ----------------------------------------------- */
    const gravar = agrupar(220, () => {
      const c = mapa.getCenter();
      escreverEstado({ z: mapa.getZoom(), lat: c.lat, lon: c.lng, proj: projecao, camadas: ligadas, ano });
    });
    mapa.on('moveend', gravar);
    mapa.on('zoomend', gravar);

    /* --- rótulos com supressão de colisão ---------------------------------- */
    type Rotulo = { el: HTMLElement; peso: number; zoomMin?: number; curto?: string; longo?: string };
    const rotulos: Rotulo[] = [];

    function criarRotulo(
      texto: string, lngLat: [number, number], classe: string, peso: number, corpo: number,
      extra: Partial<Rotulo> = {},
    ) {
      // Dois elementos de propósito: o MapLibre escreve `style.opacity` inline no
      // elemento do marcador (oclusão em projeção de globo), e inline vence classe.
      // O invólucro é dele; o rótulo estilizado é nosso.
      const inv = document.createElement('div');
      const el = document.createElement('span');
      el.className = `rot ${classe}`;
      el.textContent = texto;
      el.style.fontSize = `${corpo}px`;
      inv.appendChild(el);
      new maplibregl.Marker({ element: inv, anchor: 'left', offset: [6, 0] }).setLngLat(lngLat).addTo(mapa);
      rotulos.push({ el, peso, ...extra });
    }

    let agendado = 0;
    function resolverColisoes() {
      agendado = 0;
      if (!ligadas.has('rotulos')) return;
      const z = mapa.getZoom();
      const campoBox = campo.getBoundingClientRect();
      const aceitos: DOMRect[] = [];

      for (const r of [...rotulos].sort((a, b) => b.peso - a.peso)) {
        if (r.curto && r.longo) {
          const desejado = z >= 5 ? r.longo : r.curto;
          if (r.el.textContent !== desejado) r.el.textContent = desejado;
        }
        if (r.zoomMin !== undefined && z < r.zoomMin) { r.el.classList.add('rot--oculto'); continue; }
        r.el.classList.remove('rot--oculto');
        const cx = r.el.getBoundingClientRect();
        if (cx.width === 0) continue;
        const fora = cx.right < campoBox.left || cx.left > campoBox.right
                  || cx.bottom < campoBox.top || cx.top > campoBox.bottom;
        if (fora) { r.el.classList.add('rot--oculto'); continue; }
        const colide = aceitos.some((a) =>
          !(cx.right < a.left - 3 || cx.left > a.right + 3 || cx.bottom < a.top - 2 || cx.top > a.bottom + 2));
        if (colide) r.el.classList.add('rot--oculto');
        else aceitos.push(cx);
      }
    }
    const agendarColisoes = () => { if (!agendado) agendado = requestAnimationFrame(resolverColisoes); };

    /** ponto representativo de um polígono: centroide do maior anel */
    function centroide(geom: GeoJSON.Geometry): [number, number] | null {
      const aneis: number[][][] =
        geom.type === 'Polygon' ? [geom.coordinates[0]]
        : geom.type === 'MultiPolygon' ? geom.coordinates.map((p) => p[0]) : [];
      if (!aneis.length) return null;
      const maior = aneis.reduce((a, b) => (b.length > a.length ? b : a));
      let x = 0, y = 0;
      for (const [lon, lat] of maior) { x += lon; y += lat; }
      return [x / maior.length, y / maior.length];
    }

    (async () => {
      try {
        const [cidades, hidro, ufs] = await Promise.all([
          fetch('/dados/cidades.geojson').then((r) => r.json()),
          fetch('/dados/hidrografia.geojson').then((r) => r.json()),
          fetch('/dados/ufs.geojson').then((r) => r.json()),
        ]);

        for (const f of ufs.features) {
          const c = centroide(f.geometry);
          if (!c) continue;
          const sigla: string = f.properties.sigla || '';
          const nome: string = f.properties.nome || '';
          if (!sigla && !nome) continue;
          criarRotulo(sigla || nome, c, 'rot--regiao', 2e7, 11, { curto: sigla || nome, longo: nome || sigla });
        }

        // O acervo traz homônimos (dois "Natal", dois "Vila Velha"); numa prancha
        // de país o menor vira ruído, então fica só o de maior população.
        const porNome = new Map<string, GeoJSON.Feature>();
        for (const f of cidades.features) {
          const nome: string = f.properties?.nome ?? '';
          const anterior = porNome.get(nome);
          if (!anterior || (f.properties?.pop ?? 0) > (anterior.properties?.pop ?? 0)) porNome.set(nome, f);
        }
        for (const f of [...porNome.values()]
          .sort((a, b) => (b.properties?.pop ?? 0) - (a.properties?.pop ?? 0)).slice(0, 30)) {
          const pop: number = f.properties?.pop ?? 0;
          const nome: string = f.properties?.nome ?? '';
          const corpo = pop > 8e6 ? 15 : pop > 3e6 ? 13 : pop > 1e6 ? 12 : 10.5;
          const capital = nome === 'Brasilia' || f.properties?.capital === 1;
          criarRotulo(
            nome === 'Brasilia' ? 'Brasília' : nome,
            (f.geometry as GeoJSON.Point).coordinates as [number, number],
            capital ? 'rot--capital' : 'rot--cidade',
            capital ? 1e9 : pop + 1e8,          // cidade vence estado; capital vence tudo
            corpo,
          );
        }

        const vistos = new Set<string>();
        for (const f of hidro.features) {
          const nome: string = f.properties.nome;
          if (!nome || vistos.has(nome)) continue;
          vistos.add(nome);
          const cs = (f.geometry.type === 'LineString' ? f.geometry.coordinates : f.geometry.coordinates.flat()) as [number, number][];
          const meio = cs[Math.floor(cs.length / 2)];
          if (!meio) continue;
          const ordem = Number(f.properties.ordem) || 1;
          criarRotulo(nome, meio, 'rot--agua', 5e4 + ordem * 1e4, 12);
        }
        requestAnimationFrame(() => requestAnimationFrame(agendarColisoes));
      } catch (e) {
        console.error('[mapa] falha ao carregar rótulos', e);
      }
    })();

    mapa.on('move', agendarColisoes);
    mapa.on('zoom', agendarColisoes);
    mapa.on('load', agendarColisoes);
    mapa.on('idle', agendarColisoes);

    /* --- inspetor de clique ------------------------------------------------ */
    const inspetor = document.getElementById('inspetor');
    const corpo = document.getElementById('inspetor-corpo');
    const grau = (v: number, p: string, n: string) => {
      const a = Math.abs(v), d = Math.floor(a), m = Math.round((a - d) * 60);
      return `${d}°${String(m).padStart(2, '0')}′${v >= 0 ? p : n}`;
    };
    const coordenada = (lon: number, lat: number) => `${grau(lat, 'N', 'S')} ${grau(lon, 'L', 'O')}`;

    const fecharInspetor = () => { if (inspetor) inspetor.hidden = true; };
    document.getElementById('fechar-inspetor')?.addEventListener('click', fecharInspetor);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fecharInspetor(); });

    mapa.on('click', (e) => {
      if (!inspetor || !corpo) return;
      const achadas = mapa.queryRenderedFeatures(e.point, { layers: ['ufs-alvo', 'vizinhos-alvo'] });
      const uf = achadas.find((f) => f.layer.id === 'ufs-alvo');
      const viz = achadas.find((f) => f.layer.id === 'vizinhos-alvo');
      const onde = coordenada(e.lngLat.lng, e.lngLat.lat);

      if (uf) {
        const p = uf.properties as Record<string, string>;
        corpo.innerHTML = `
          <h5>${p.nome ?? 'Unidade federativa'}</h5>
          <span class="sigla">${p.sigla ? `BR-${p.sigla}` : 'unidade federativa'}</span>
          <dl>
            <div><dt>Região</dt><dd>${p.regiao || '—'}</dd></div>
            <div><dt>País</dt><dd>Brasil</dd></div>
            <div><dt>Ponto clicado</dt><dd class="mono">${onde}</dd></div>
          </dl>
          <p class="lacuna">A prancha desta unidade ainda não existe — entra na Fase 3.
          O atlas declara a lacuna em vez de servir uma página vazia.</p>`;
      } else if (viz) {
        const p = viz.properties as Record<string, string>;
        corpo.innerHTML = `
          <h5>${p.nome ?? 'País limítrofe'}</h5>
          <span class="sigla">fora do território em foco</span>
          <dl><div><dt>Ponto clicado</dt><dd class="mono">${onde}</dd></div></dl>
          <p class="lacuna">Está sob o véu porque esta prancha é do Brasil. A prancha
          deste país ainda não existe.</p>`;
      } else {
        corpo.innerHTML = `
          <h5>Oceano</h5>
          <span class="sigla">sem feição no acervo</span>
          <dl><div><dt>Ponto clicado</dt><dd class="mono">${onde}</dd></div></dl>
          <p class="lacuna">A batimetria está desenhada pela rampa, mas o acervo ainda
          não tem itens de oceano — nem fossas, nem correntes, nem cabos.</p>`;
      }
      inspetor.hidden = false;
    });

    mapa.on('mouseenter', 'ufs-alvo', () => { mapa.getCanvas().style.cursor = 'pointer'; });
    mapa.on('mouseleave', 'ufs-alvo', () => { mapa.getCanvas().style.cursor = ''; });

    /* --- leitura de coordenada e escala ------------------------------------ */
    const coord = document.getElementById('coord');
    mapa.on('mousemove', (e) => {
      if (coord) coord.textContent = coordenada(e.lngLat.lng, e.lngLat.lat);
    });
    mapa.on('mouseout', () => { if (coord) coord.textContent = '—'; });

    const escalaTxt = document.getElementById('escala-txt');
    const atualizarEscala = () => {
      if (!escalaTxt) return;
      const m = (156543.03392 * Math.cos((mapa.getCenter().lat * Math.PI) / 180)) / 2 ** mapa.getZoom();
      const km = Math.round((m * 104) / 1000);
      escalaTxt.textContent = `0 ——— ${km.toLocaleString('pt-BR')} km`;
    };
    mapa.on('zoom', atualizarEscala);
    mapa.on('moveend', atualizarEscala);   // em Mercator a escala muda com a latitude
    mapa.on('load', atualizarEscala);

    /* =====================================================================
       O TEMPO COMANDA AS CAMADAS
       Mover o ano não troca de página: troca o que está em vigor. Cada item
       carrega a própria vigência, e é ela que decide o que aparece.
       ===================================================================== */
    const barraAno = document.getElementById('ano') as HTMLInputElement | null;
    const valorAno = document.getElementById('ano-valor');
    const estadoTempo = document.getElementById('tempo-estado');

    function aplicarAno(novo: number, gravarTambem = true) {
      ano = novo;
      if (valorAno) valorAno.textContent = String(novo);
      if (barraAno && Number(barraAno.value) !== novo) barraAno.value = String(novo);

      // capital em vigor no ano
      const capital = capitais.find((c) => vigenteEm(c.vigencia, novo));
      const fonteCapital = mapa.getSource('capital') as maplibregl.GeoJSONSource | undefined;
      fonteCapital?.setData({
        type: 'FeatureCollection',
        features: capital
          ? [{
              type: 'Feature',
              properties: { nome: capital.nome.valor },
              geometry: { type: 'Point', coordinates: capital.ponto },
            }]
          : [],
      });

      // Tordesilhas: some antes de 1494, vigora até 1750, depois fica como traço histórico
      const tord = estadoDeVigencia({ de: TORDESILHAS.assinado, ate: TORDESILHAS.revogado }, novo);
      const mostrarTord = tord !== 'ainda não';
      for (const camada of ['tordesilhas-faixa', 'tordesilhas-tracado']) {
        if (mapa.getLayer(camada)) {
          mapa.setLayoutProperty(camada, 'visibility', mostrarTord ? 'visible' : 'none');
        }
      }
      if (mapa.getLayer('tordesilhas-faixa')) {
        mapa.setPaintProperty('tordesilhas-faixa', 'fill-opacity', tord === 'em vigor' ? 0.18 : 0.07);
      }
      if (mapa.getLayer('tordesilhas-tracado')) {
        mapa.setPaintProperty('tordesilhas-tracado', 'line-opacity', tord === 'em vigor' ? 1 : 0.4);
      }

      if (estadoTempo) {
        const fichas: string[] = [];
        fichas.push(capital
          ? `<span class="vigente">capital: ${capital.nome.valor}</span>`
          : '<span>sem capital constituída</span>');
        if (mostrarTord) {
          fichas.push(tord === 'em vigor'
            ? '<span class="vigente">Tordesilhas em vigor</span>'
            : '<span class="revogada">Tordesilhas revogada em 1750</span>');
        }
        if (novo < ANO_MAXIMO) {
          fichas.push('<span>fronteiras e cidades ainda são as de hoje</span>');
        }
        estadoTempo.innerHTML = fichas.join('');
      }

      if (gravarTambem) gravar();
    }

    barraAno?.addEventListener('input', () => aplicarAno(Number(barraAno.value)));
    mapa.once('load', () => aplicarAno(ano, false));

    /* --- pilha de camadas --------------------------------------------------- */
    const alvos: Record<string, string[]> = {
      relevo: ['relevo', 'veu-vizinhos'],
      ufs: ['ufs-linha'],
      hidrografia: ['hidrografia-linha'],
      graticulado: ['graticulado'],
      tissot: ['tissot-area', 'tissot-linha'],
    };
    const aplicar = (chave: string, ligado: boolean) => {
      if (ligado) ligadas.add(chave); else ligadas.delete(chave);
      if (chave === 'rotulos') {
        rotulos.forEach((r) => r.el.classList.toggle('rot--oculto', !ligado));
        if (ligado) agendarColisoes();
      } else {
        for (const camada of alvos[chave] ?? []) {
          if (mapa.getLayer(camada)) mapa.setLayoutProperty(camada, 'visibility', ligado ? 'visible' : 'none');
        }
      }
      gravar();
    };

    document.querySelectorAll<HTMLInputElement>('[data-camada]').forEach((cx) => {
      cx.checked = ligadas.has(cx.dataset.camada!);          // o endereço manda na caixa
      cx.addEventListener('change', () => aplicar(cx.dataset.camada!, cx.checked));
    });

    document.querySelectorAll<HTMLInputElement>('input[name="proj"]').forEach((rd) => {
      rd.checked = rd.value === projecao;
      rd.addEventListener('change', () => {
        if (!rd.checked) return;
        projecao = rd.value as 'mercator' | 'globe';
        mapa.setProjection({ type: projecao });
        agendarColisoes();
        gravar();
      });
    });
  }
</script>
