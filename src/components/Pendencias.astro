---
/** Mostra ao leitor o que ainda não foi conferido na fonte primária. PR. 05. */
import type { Registro } from '../lib/acervo';
interface Props { r: Registro }
const { r } = Astro.props;
const p = r.pendencias();
---
{p.length > 0 && (
  <div class="pend">
    <h4>
      <span class="certeza certeza--aproximada">A conferir</span>
      {p.length} de {r.total()} valores
    </h4>
    <p class="fina">
      Estes valores foram lançados a partir da fonte indicada mas ainda não foram
      conferidos contra o documento primário. O atlas mostra a pendência em vez de
      escondê-la — a lista de incertezas conhecidas é parte do método, não um defeito.
    </p>
    <ul class="pend__lista">{p.map((caminho) => <li>{caminho}</li>)}</ul>
  </div>
)}
<style>
  .pend { border: 1px solid var(--cert-aproximada); padding: var(--s-4); background: var(--sunk); }
  .pend h4 {
    display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap;
    font-family: var(--sans); font-size: var(--t-sm); font-weight: 600; margin-bottom: var(--s-2);
  }
  .pend p { margin-bottom: var(--s-3); }
  .pend__lista {
    list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem;
    font-family: var(--mono); font-size: var(--t-xs);
  }
  .pend__lista li { border: 1px solid var(--rule); padding: .15rem .35rem; color: var(--ink-3); }
</style>
